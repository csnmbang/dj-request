# Set these in Vercel → Project → Settings → Environment Variables.
# Never commit real values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=      # Supabase → Settings → API → service_role (server only!)
YOUTUBE_API_KEY=                # Google Cloud → YouTube Data API v3 key
DJ_PIN=                         # use 8+ characters: there is no lockout after wrong guesses
NTFY_TOPIC=                     # optional: a long random name, e.g. bangher-7f3k9q2x
